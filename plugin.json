{
    "name": "Dixlase Pages",
    "package_name": "dixlase/dixlase-pages",
    "slug": "dixlase-pages",
    "version": "1.0.0",
    "description": {
        "ja": "固定ページ管理機能を提供するプラグインです。",
        "en": "This plugin provides static page management functionality."
    },
    "author": "exc-D inc.",
    "email": "office@exc-d.com",
    "url": "https://exc-d.com",
    "license": "GPL-3.0",
    "license_template": "license-gpl.txt",
    "providers": [
        "Plugins\\DixlasePages\\App\\Providers\\DixlasePagesServiceProvider"
    ],
    "namespace": "Plugins\\DixlasePages",
    "type": "dixlase-plugin",
    "category": "content",
    "tags": [
        "pages",
        "content",
        "cms"
    ],
    "requires": {
        "dixlase": ">=1.0.0",
        "php": ">=8.0"
    },
    "provides": {
        "admin_menu": true,
        "front_routes": true,
        "api_routes": false,
        "settings_page": true
    },
    "declares": {
        "configs": {
            "roles": false,
            "database_cleanup": false,
            "navigation": true
        },
        "assets": {
            "common": ["js/app.js", "css/style.scss"],
            "admin": [],
            "front": []
        },
        "contracts": ["RouteSlugProvider"],
        "migrations": true,
        "commands": false,
        "middleware": false
    },
    "permissions": {
        "database": {
            "own_tables": true,
            "core_tables": []
        },
        "storage": {
            "own_directory": true,
            "public_uploads": false,
            "temp_files": false
        },
        "settings": {
            "read_core": true,
            "write_own": false
        },
        "members": {
            "read": false,
            "write": false,
            "create": false,
            "delete": false
        },
        "mail": {
            "send": false,
            "bulk_send": false
        },
        "content": {
            "read_other_plugins": [],
            "write_other_plugins": []
        },
        "system": {
            "register_shortcodes": false,
            "register_middleware": false,
            "register_commands": false,
            "register_blade_directives": false,
            "modify_routes": false
        },
        "_optional": [],
        "_notes": {
            "ja": "",
            "en": ""
        }
    }
}
