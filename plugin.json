{
    "name": "Dixlase Pages",
    "package_name": "dixlase/dixlase-pages",
    "slug": "dixlase-pages",
    "version": "1.0.0",
    "description": {
        "ja": "固定ページ管理機能を提供するプラグインです。",
        "en": "This plugin provides static page management functionality."
    },
    "author": "exc-D inc.",
    "author_id": "exc-d-inc",
    "authority_key_id": "dixlase-authority-2026",
    "email": "office@exc-d.com",
    "url": "https://exc-d.com",
    "license": "GPL-3.0-or-later",
    "license_template": "license-dual-gpl.txt",
    "commercial_license": {
        "available": true,
        "file": "LICENSE.commercial",
        "contact": "office@exc-d.com"
    },
    "assets": {
        "license": null,
        "attributions_file": null,
        "third_party": []
    },
    "namespace": "Plugins\\DixlasePages",
    "providers": [
        "Plugins\\DixlasePages\\App\\Providers\\DixlasePagesServiceProvider"
    ],
    "type": "dixlase-plugin",
    "category": "content",
    "tags": [
        "pages",
        "content",
        "cms"
    ],
    "capabilities": [
        "seo-meta",
        "linkable",
        "multilingual-content"
    ],
    "multilingual_content": {
        "types": [
            {
                "key": "dixlase-pages:page",
                "model": "Plugins\\DixlasePages\\App\\Models\\DixlasePagesPage",
                "label_field": "title",
                "fields": [
                    {
                        "name": "title",
                        "type": "text",
                        "rules": "required|string|max:255"
                    },
                    {
                        "name": "content",
                        "type": "richtext",
                        "rules": "nullable|string"
                    }
                ]
            }
        ]
    },
    "requires": {
        "dixlase": "^0.1.0",
        "php": ">=8.0"
    },
    "provides": {
        "admin_menu": true,
        "front_routes": true,
        "api_routes": false,
        "settings_page": true
    },
    "declares": {
        "configs": {
            "roles": false,
            "database_cleanup": false,
            "navigation": true
        },
        "assets": {
            "common": [
                "js/app.js",
                "css/style.scss"
            ],
            "admin": [],
            "front": []
        },
        "contracts": [
            "RouteSlugProvider"
        ],
        "migrations": true,
        "commands": false,
        "middleware": false
    },
    "permissions": {
        "database": {
            "own_tables": true,
            "core_tables": []
        },
        "storage": {
            "own_directory": true,
            "public_uploads": false,
            "temp_files": false
        },
        "settings": {
            "read_core": true,
            "write_own": false
        },
        "members": {
            "read": false,
            "write": false,
            "create": false,
            "delete": false
        },
        "mail": {
            "send": false,
            "bulk_send": false
        },
        "content": {
            "read_other_plugins": [
                "dixlase-seo"
            ],
            "write_other_plugins": [
                "dixlase-seo"
            ]
        },
        "system": {
            "register_shortcodes": false,
            "register_middleware": false,
            "register_commands": false,
            "register_blade_directives": false,
            "modify_routes": false
        },
        "_optional": [],
        "_notes": {
            "ja": "",
            "en": ""
        }
    },
