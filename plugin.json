{
    "name": "Dixlase Pages",
    "package_name": "dixlase/dixlase-pages",
    "slug": "dixlase-pages",
    "version": "0.1.0",
    "description": {
        "ja": "固定ページ管理機能を提供するプラグインです。",
        "en": "This plugin provides static page management functionality."
    },
    "author": "exc-D inc.",
    "author_id": "exc-d-inc",
    "authority_key_id": "dixlase-authority-2026",
    "email": "info@dixlase.org",
    "url": "https://exc-d.com",
    "license": "GPL-3.0-or-later",
    "license_template": "license-dual-gpl.txt",
    "commercial_license": {
        "available": false,
        "file": "LICENSE-COMMERCIAL",
        "contact": "info@dixlase.org"
    },
    "assets": {
        "license": null,
        "attributions_file": null,
        "third_party": []
    },
    "thumbnail": "thumbnail.png",
    "namespace": "Plugins\\DixlasePages",
    "providers": [
        "Plugins\\DixlasePages\\App\\Providers\\DixlasePagesServiceProvider"
    ],
    "type": "dixlase-plugin",
    "category": "content",
    "tags": [
        "pages",
        "content",
        "cms"
    ],
    "capabilities": [
        "seo-meta",
        "linkable",
        "multilingual-content"
    ],
    "multilingual_content": {
        "types": [
            {
                "key": "dixlase-pages:page",
                "model": "Plugins\\DixlasePages\\App\\Models\\DixlasePagesPage",
                "label_field": "title",
                "fields": [
                    {
                        "name": "title",
                        "type": "text",
                        "rules": "required|string|max:255"
                    },
                    {
                        "name": "content",
                        "type": "richtext",
                        "rules": "nullable|string"
                    },
                    {
                        "name": "seo_description",
                        "type": "textarea",
                        "rules": "nullable|string|max:300"
                    }
                ]
            }
        ]
    },
    "requires": {
        "dixlase": "^0.1.0",
        "dixlase_api": "^0.1",
        "php": ">=8.3"
    },
    "provides": {
        "admin_menu": true,
        "front_routes": true,
        "api_routes": false,
        "settings_page": true
    },
    "declares": {
        "configs": {
            "roles": false,
            "database_cleanup": false,
            "navigation": true
        },
        "assets": {
            "common": [
                "js/app.js",
                "css/style.scss"
            ],
            "admin": [],
            "front": []
        },
        "contracts": [
            "RouteSlugProvider"
        ],
        "tailwind_content": [
            "storage/app/private/dixlase-pages"
        ],
        "migrations": true,
        "commands": false,
        "middleware": false
    },
    "permissions": {
        "database": {
            "own_tables": true,
            "core_tables_read": [
                "site_settings",
                "media",
                "themes",
                "theme_settings"
            ],
            "core_tables_write": []
        },
        "storage": {
            "own_directory": true,
            "public_uploads": false,
            "temp_files": false
        },
        "settings": {
            "read_core": true,
            "write_own": false
        },
        "members": {
            "read": false,
            "write": false,
            "create": false,
            "delete": false
        },
        "mail": {
            "send": false,
            "bulk_send": false
        },
        "content": {
            "read_other_plugins": [
                "dixlase-seo"
            ],
            "write_other_plugins": [
                "dixlase-seo"
            ]
        },
        "system": {
            "register_shortcodes": false,
            "register_middleware": false,
            "register_commands": false,
            "register_blade_directives": false,
            "modify_routes": false
        },
        "_optional": [],
        "_notes": {
            "en": "site_settings is read for admin-mode detection and the site default locale; media is read for the SEO OGP image lookup; themes and theme_settings are read directly to render the admin preview frame because no core ThemeRegistryInterface contract exists yet (slated for v0.2). DixlasePagesPageRevision uses App\\Models\\Member as a belongs-to relation target for the revision author (framework convention; MemberRepositoryInterface pending in v0.2). Default role permissions for the Pages admin menus are declared in config/admin/roles.php and resolved at runtime by the core PermissionRegistry; no core table is written during install.",
            "ja": "site_settings は管理モード判定とサイト既定ロケール取得用、media は SEO OGP 画像の検索用に参照する。themes / theme_settings は管理プレビューフレーム描画用に直接参照しているが、コアの ThemeRegistryInterface contract が未整備のため当面の措置 (v0.2 で contract に移行予定)。DixlasePagesPageRevision はリビジョン作成者を保持するため App\\Models\\Member を belongs-to 関連の対象として参照する (フレームワーク慣習、MemberRepositoryInterface は v0.2 で追加予定)。Pages 管理メニューのデフォルトロール権限は config/admin/roles.php で宣言し、コアの PermissionRegistry が実行時に解決する。インストール時にコアのテーブルへ書き込みは行わない。"
        }
    },
